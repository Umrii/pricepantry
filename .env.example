# ------------------------------------------------------------------
# Price Pantry — environment configuration
# Copy this file to `.env` and adjust values as needed.
# ------------------------------------------------------------------

# ---- PostgreSQL ----
POSTGRES_USER=pricepantry
POSTGRES_PASSWORD=pricepantry
POSTGRES_DB=pricepantry
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQLAlchemy connection string used by the backend & scraper.
# Inside Docker, host is the `db` service name. For local runs use localhost.
DATABASE_URL=postgresql+psycopg://pricepantry:pricepantry@db:5432/pricepantry

# ---- Backend (FastAPI) ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed CORS origins (the frontend URL).
CORS_ORIGINS=http://localhost:3000

# ---- Frontend (Next.js) ----
# Public base URL of the backend API, used by the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Scraper ----
# Number of category pages to walk per run (keep small while testing).
SCRAPER_MAX_PAGES=2
# Run the browser headless (true) or headful (false, better vs bot detection).
SCRAPER_HEADLESS=true
